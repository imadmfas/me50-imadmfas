# Disable pnpm's "minimum release age" supply-chain check for this project.
# It rejects any package published too recently (a real anti-supply-chain-
# attack feature), but that also blocks perfectly legitimate routine
# releases of well-known packages (postcss, etc.) right after publish,
# which makes a freshly generated lockfile unable to install on some
# machines depending on when `pnpm install` is first run. All dependencies
# here are widely used, actively maintained packages — see package.json
# files throughout the monorepo.
minimum-release-age=0
