# Local dev default — SQLite, zero setup. For production point this at
# Postgres (Supabase/Neon) and switch schema.prisma's datasource provider.
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS + Socket.IO.
CORS_ORIGIN="http://localhost:5173"

# Generate real secrets for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Leave blank to run with push notifications disabled — the app degrades
# gracefully (see PHASE7 notes in README.md).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@drimad.net"

# Optional: Resend email fallback for notifications.
RESEND_API_KEY=""

# Optional: Sentry error reporting hook.
SENTRY_DSN=""
